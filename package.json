{
  "name": "uiblame-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w uiblame && npm run build -w @uiblame/demo",
    "dev": "npm run dev -w @uiblame/demo",
    "test": "npm run test -w uiblame",
    "test:dogfood": "node scripts/check-dogfood.mjs",
    "test:production": "node scripts/check-production.mjs",
    "check": "npm run build && npm test && npm run test:dogfood && npm run test:production",
    "pack:check": "node scripts/check-package.mjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
