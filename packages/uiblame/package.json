{
  "name": "uiblame",
  "version": "0.1.0",
  "description": "Evidence-based visual provenance for UI: trace rendered elements to source, Git history, and recorded AI sessions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "uiblame": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "vite",
    "git-blame",
    "provenance",
    "ai",
    "ai-provenance",
    "developer-tools",
    "react",
    "debugging"
  ],
  "homepage": "https://github.com/Trin0110/UIBlame#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trin0110/UIBlame.git",
    "directory": "packages/uiblame"
  },
  "bugs": {
    "url": "https://github.com/Trin0110/UIBlame/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "^7.28.4",
    "@babel/types": "^7.28.4"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "peerDependencies": {
    "vite": ">=6 <8"
  }
}
